{
  "name": "trading-persistence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend de persistencia para el motor de matching HFT (ARTI4109 - Reto 1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "bridge": "node scripts/bridge.js",
    "loadtest": "node scripts/loadtest.js",
    "test": "node --test test/*.test.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:up:engine": "docker compose --profile engine up -d",
    "docker:logs": "docker compose logs -f api bridge",
    "docker:down": "docker compose --profile engine down"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
