# ==========================================================================
# Backend de Persistencia de Trading — ARTI4109 Reto 1
# Copia este archivo a `.env` y completa los valores reales.
#   cp .env.example .env
# ==========================================================================

# --------------------------------------------------------------------------
# Servidor HTTP
# --------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Base de datos — AWS RDS PostgreSQL
# --------------------------------------------------------------------------
# Opción A: una sola URL de conexión (tiene prioridad si está definida)
# DATABASE_URL=postgresql://usuario:password@mi-instancia.xxxxx.us-east-1.rds.amazonaws.com:5432/trading

# Opción B: parámetros sueltos
PGHOST=localhost
PGPORT=5432
PGDATABASE=trading
PGUSER=trading
PGPASSWORD=trading

# SSL: RDS lo exige en producción. Usa `require` contra RDS y `disable` en local.
#   disable  -> sin TLS (docker local)
#   require  -> TLS sin validar la CA (lo más común contra RDS)
#   verify   -> TLS validando la CA (requiere PGSSLROOTCERT con el bundle de AWS)
PGSSLMODE=disable
# PGSSLROOTCERT=./certs/rds-combined-ca-bundle.pem

# Pool de conexiones
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000

# --------------------------------------------------------------------------
# Motor de Matching (corre en OTRA máquina — MatchineEngine.jar)
# --------------------------------------------------------------------------
ENGINE_BASE_URL=http://localhost:8080
ENGINE_TIMEOUT_MS=2000
# Reintentos ante fallo de red al inyectar una orden en el motor
ENGINE_RETRY_ATTEMPTS=2
ENGINE_RETRY_DELAY_MS=50
# Sondeo de salud del motor: detecta reinicios y rota la sesión para no
# mezclar IDs de órdenes de dos ejecuciones distintas del motor. 0 = desactivado.
ENGINE_HEALTH_POLL_MS=5000

# --------------------------------------------------------------------------
# Estrategia de escritura a la RDS
# --------------------------------------------------------------------------
# async -> write-behind por lotes; la persistencia queda FUERA del camino
#          crítico (equivale al "JDBC upsert (batch)" del diagrama de despliegue).
# sync  -> se escribe a la RDS antes de responder. Más durable, más latencia.
PERSIST_MODE=async

# Parámetros del escritor por lotes (solo aplican en modo async)
BATCH_SIZE=500
BATCH_INTERVAL_MS=25
BATCH_MAX_QUEUE=100000
BATCH_RETRY_ATTEMPTS=3
BATCH_RETRY_DELAY_MS=100
# Si la cola supera este porcentaje de BATCH_MAX_QUEUE se responde 503 (backpressure)
BATCH_HIGH_WATERMARK_PCT=90
# Archivo donde se vuelcan los lotes que fallaron definitivamente (dead letter)
DEAD_LETTER_PATH=./logs/dead-letter.ndjson

# --------------------------------------------------------------------------
# Reglas de negocio
# --------------------------------------------------------------------------
# Comisión del intermediario en puntos básicos (25 = 0.25%) por lado
FEE_BPS=25
# Nº de activos que admite el motor (valida idActivo en [0, ASSET_COUNT-1])
ASSET_COUNT=5
# Crear automáticamente el usuario si no existe al registrar una orden
AUTO_CREATE_USERS=true
# Validar que el vendedor tenga las acciones / el comprador tenga saldo.
# El motor NO valida esto; actívalo solo si quieres esa regla de negocio.
ENFORCE_BALANCES=false

# --------------------------------------------------------------------------
# Ingesta de trades
# --------------------------------------------------------------------------
# Token compartido que debe enviar el worker en `X-Ingest-Token` al hacer
# POST /api/v1/trades. Vacío = sin autenticación (solo para desarrollo).
INGEST_TOKEN=

# --------------------------------------------------------------------------
# Puente opcional WS -> HTTP (scripts/bridge.js, `npm run bridge`)
# Proceso aparte que escucha los trades del motor y los empuja a este backend.
# Equivale al "Worker de Persistencia" del diagrama de despliegue.
# --------------------------------------------------------------------------
BRIDGE_ENGINE_WS_URL=ws://localhost:8080/api/trades/stream
BRIDGE_TARGET_URL=http://localhost:3000/api/v1/trades
BRIDGE_BATCH_SIZE=200
BRIDGE_FLUSH_MS=50

# --------------------------------------------------------------------------
# Solo para `docker compose`
#
# Dentro de un contenedor, `localhost` es el propio contenedor, así que las
# variables de arriba con localhost no sirven ahí. El compose las sobreescribe
# con estos valores; solo hay que tocarlos si algo vive fuera del compose.
# --------------------------------------------------------------------------
# Base de datos: dentro de Docker se ignoran PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# del .env (suelen ser los de la RDS) y se usa el postgres del compose, que
# es siempre trading/trading/trading. Con DATABASE_URL definido, gana esta.
# PGHOST_DOCKER=postgres
# PGPORT_DOCKER=5432
# PGDATABASE_DOCKER=trading
# PGUSER_DOCKER=trading
# PGPASSWORD_DOCKER=trading
# TLS dentro del contenedor: con DATABASE_URL (RDS) es `require` automáticamente;
# contra el postgres del compose es `disable`. Solo define esto para forzarlo:
# PGSSLMODE_DOCKER=require

# Motor. Por defecto apunta al servicio `engine` del perfil homónimo. Si el
# motor corre en otra máquina (el escenario real), pon aquí su IP o DNS:
# ENGINE_BASE_URL_DOCKER=http://engine:8080
# ENGINE_BASE_URL_DOCKER=http://10.0.1.20:8080
# BRIDGE_ENGINE_WS_URL_DOCKER=ws://engine:8080/api/trades/stream
# BRIDGE_ENGINE_WS_URL_DOCKER=ws://10.0.1.20:8080/api/trades/stream
# BRIDGE_TARGET_URL_DOCKER=http://api:3000/api/v1/trades

# Puertos publicados en el host (por si 3000/5432/8080 ya están ocupados)
# PORT_HOST=3000
# PGPORT_HOST=5432
# ENGINE_PORT_HOST=8080

# Puerto en el que escucha el backend DENTRO del contenedor. Ponerlo en 80
# (junto con PORT_HOST=80) hace que los endpoints queden en http://IP/api/v1/...
# sin puerto en la URL. El usuario sin privilegios de la imagen puede abrirlo
# porque Docker fija net.ipv4.ip_unprivileged_port_start=0 en el contenedor.
# El HEALTHCHECK y el BRIDGE_TARGET_URL interno lo siguen solos.
# PORT_DOCKER=3000

# Cuántas instancias del worker WS->HTTP levanta el compose. SIEMPRE 1 en el
# stack principal. En los clones que van detrás de un balanceador, 0: el motor
# emite los trades por broadcast, así que dos bridges reciben cada trade dos
# veces. El índice único (sesión, buyOrderId, sellOrderId) evita el duplicado
# en la base, pero se duplica el trabajo y las métricas dejan de cuadrar.
# BRIDGE_REPLICAS=1
